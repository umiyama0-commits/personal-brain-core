# brain-agent 環境変数テンプレ
# .env にコピー → 実値を投入。.env は git ignore されている。

# ─── LiteLLM ──────────────────────────────────
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-brain-XXXX
REDIS_URL=redis://redis:6379

# ─── LLM Providers (litellm 経由でも直接呼びでも) ──
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ─── LINE Bot (海山 個人) ──────────────────────
LINE_CHANNEL_ACCESS_TOKEN=...
LINE_CHANNEL_SECRET=...

# ─── LINE Works (うみやまAI Bot) ───────────────
LW_CLIENT_ID=xxx
LW_CLIENT_SECRET=xxx
LW_SERVICE_ACCOUNT=xxxxxx.serviceaccount@owndays
LW_PRIVATE_KEY_PATH=/app/data/brain/.lw_private_key.pem
LW_BOT_ID=xxx
LW_BOT_SECRET=xxx

# ─── OWNDAYS Net Mobile (売上 scraper) ────────
OWNDAYS_MOBILE_USER=<your-username>
OWNDAYS_MOBILE_PASS=<your-password>      # ★平文 commit 禁止、実値は .env のみに

# ─── LINE Works scraper (社内チャット) ─────────
LINEWORKS_USER=your-account@your-lw-domain
LINEWORKS_PASS=...

# ─── STAPA (社内メルマガ) ──────────────────────
STAPA_USER=...
STAPA_PASS=...

# ─── kpi-dash.com Dashboard scraper (★2026-05-25 海山指示) ────
# 月曜 18:00 JST 週次、Playwright で login + /dashboard BFS 巡回
KPIDASH_USER=...
KPIDASH_PASS=...
# KPIDASH_LOGIN_URL は省略時 https://kpi-dash.com/login (OAuth/SSO の場合は専用 URL を指定)

# ─── Gemini API (★2026-05-26 海山指示: Drive AI 検索用) ───
# https://aistudio.google.com で 5 分で取得、無料枠 15 RPM / 1M token/day
# /drive ai <query> で query 拡張 + 結果 re-rank に使用
GEMINI_API_KEY=...
# GEMINI_MODEL は省略時 gemini-2.5-flash-lite (= 高速・thinking 無・JSON 安定・billing 必須)
# 注意: 新規 billing アカウントは gemini-2.0-flash 拒否 (404)、gemini-2.5-flash は
# thinking mode 有効で JSON 前 prose 入り MAX_TOKENS truncation 問題あり。
# よって lite variant 推奨。コスト ~$0.075/1M token (= 月 10k query で <$1)。

# ─── Drive 共有依頼用アドレス (★2026-05-23 海山指示) ────────────
# うみやまAI が viewer 権限の無い Drive ファイルを共有された時に、user に伝える宛先。
# **推奨**: bot 専用 Google Workspace アカウント (例: bot-account@example.co.jp) を
#   IT 部門に発行依頼 → 切替手順は docs/integrations/gdrive-sync.md 参照。
# 同アカウントは将来の Meet 招待先・Gmail 連携・Calendar 連携の起点にもなる。
# 未設定なら「公開範囲を見直すか PDF で投げて」と曖昧フォールバック。
BOT_GDRIVE_SHARE_ADDRESS=

# ─── Recall.ai (会議 bot) ─────────────────────
RECALL_API_KEY=...
RECALL_WEBHOOK_SECRET=whsec_...
RECALL_API_BASE=https://api.recall.ai

# ─── Vapi (音声アラインメント — 電話 + Web 経由) ─────────
# Vapi dashboard で設定する共有シークレット (X-Vapi-Secret ヘッダ照合用)
# 空なら署名検証スキップ (開発時のみ。本番は必ず設定)
VAPI_SECRET=...
# Vapi private API key (★2026-05-23 追加、過去 call backfill / billing 監視用)
# Vapi dashboard → API Keys → Private Key (sk_xxx)
VAPI_PRIVATE_API_KEY=...
# ★2026-05-21 Web 経路 (telephony fee 無料化、30-50% コスト削減):
# Vapi dashboard → API Keys → Create Public Key で pk_... を発行
# brain.example.com/voice-align で Vapi Web SDK が WebRTC 直結する
VAPI_PUBLIC_KEY=
# /voice-align ページへのアクセス保護 (任意、空ならノーガード)
# 設定すると brain.example.com/voice-align?token=<この値> でないと 401
VOICE_ALIGN_TOKEN=

# ─── Google API (Drive / Gmail / Calendar) ────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# ─── 動作モード / 切替フラグ ───────────────────
CLONE_PUBLIC_PROD_MODEL=smart           # smart / fast-gpt / smart-gpt
CLONE_MEMORY_ENABLED=1                  # 0 で個別メモリー無効化
CLONE_FEEDBACK_DIGEST_HOUR=15
CLONE_LEARNING_DIGEST_HOUR=16
CLONE_LEARNING_SCAN_HOUR=2

# URL fetch 上限
URL_FETCH_MAX_URLS=5
URL_FETCH_MAX_CHARS_PER_URL=50000
URL_FETCH_MAX_TOTAL_CHARS=180000
URL_FETCH_TIMEOUT_SEC=60

# Wiki refine threshold
BRAIN_REFINE_MIN_RATIO=0.7
BRAIN_COMPILE_MODEL=fast-gpt

# Auto-deploy (★2026-05-15 追加、別 PC から git push → メイン Mac で自動 pull)
AUTO_DEPLOY_ENABLED=1
AUTO_DEPLOY_BRANCH=main
BRAIN_MCP_TOKEN=...
# ★2026-06-08 評価 0-2: deploy/rebuild (docker socket = RCE 相当) を閲覧 token と分離。
#   未設定なら ALIGNMENT_TRIAL_TOKEN に fallback (= 現行どおり動く)。設定すると閲覧 token では deploy 不可。
DEPLOY_ADMIN_TOKEN=
# ★2026-06-08 評価 LLMOps G1: deploy 後 eval gate。
#   warn = regression を LINE alert のみ + verdict 記録 (deploy は止めない)。
#   block = regression 時に前 image へ自動 rollback (= 門が閉まる)。off = 無効 (opt-out)。
#   ★2026-06-08 評価#1 (hard-gate wall を渡る): 既定を off→**warn** に昇格。auto_deploy は
#   未設定なら warn で走る。warn で数週 baseline + 誤検知率 (data/brain/alignment/
#   eval_gate_verdicts.jsonl の regression 件数 ÷ deploy 件数) を実測 → 誤検知ゼロを確認したら
#   block に切替。劣化 deploy を自動巻き戻す前に「正常 deploy を誤って巻き戻さない」を実証する順序。
DEPLOY_EVAL_GATE=warn
DEPLOY_EVAL_THRESHOLD=0.9
# ★2026-07-02 監査B (deploy-eval-gate-opus-cost-spike): gate は「bot 応答に影響する変更」時のみ +
#   min interval (h)。1 で毎 push 実行の旧挙動 (コスト増、デバッグ用)。
DEPLOY_EVAL_MIN_INTERVAL_H=6
DEPLOY_EVAL_GATE_ALWAYS=0

# ★2026-06-08 評価 Tier0 #1: 一次データの offsite 暗号化 backup (restic → B2/S3)。
#   要 brew install restic。未設定なら backup_offsite.sh は loud-skip。
#   RESTIC_PASSWORD は repo 暗号化キー = 失うと復元不能、別途厳重保管。
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# B2 利用時:
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# S3 利用時 (B2 と排他):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Codex 定期コードレビュー (★2026-06-08 海山指示、別系列 GPT-5 で独立レビュー) ───
# codex exec (read-only) で週次 diff + 月次 sweep。未設定なら loud-skip。
CODEX_API_KEY=
# 使うモデル。未指定なら Codex CLI 既定 (= 通常 GPT-5.5)。
#   gpt-5.5            汎用・既定 (thorough、週次低頻度なのでレビュー品質優先ならこれ)
#   gpt-5.3-codex-spark  coding 特化 (高速・低コスト)
# CODEX_REVIEW_MODEL=gpt-5.5

# ─── ElevenLabs (うみやま Voice Clone TTS) ★2026-05-21 ───
# Voice Lab で Pro Voice Clone 作成 → ⋮ → 声のIDをコピー
ELEVENLABS_VOICE_ID=
# Profile → API Keys → Create で権限選択:
#   ★2026-05-26 海山 fix: Vapi 連携には Text-to-Speech だけだと不足、追加で
#     - user.read (= Vapi の key 検証時に /v1/user 叩く)
#     - voices.read (= voice list 取得)
#   が必要。clone_voice.py の単体 TTS は text_to_speech 権限のみで OK だが、
#   Vapi 経由で動的 voice 生成するなら **3 権限全部 ✅** 推奨。月次クレジット
#   上限 (= 100K chars 等) も同画面で設定推奨。
ELEVENLABS_API_KEY=

# ─── Vapi 音声アラインメントの声 (★2026-05-26 海山指示) ────────
# Vapi の voice config を env で調整可能化。default で ElevenLabs Pro Voice Clone
# (= 海山本人声) を primary、Azure Keita を fallback とする。
# Vapi dashboard → Provider Keys に ElevenLabs API key 登録が前提
# (= 登録なしだと常に Azure fallback 動作)。
VAPI_VOICE_PROVIDER=11labs              # 11labs (default、海山声) / azure (= 旧 Keita 戻し)
# ★2026-05-26 4th pass: 「スピード若干速い / 間が不自然 / 雑音もう少し」 FB 反映
VAPI_VOICE_MODEL=eleven_turbo_v2_5      # eleven_turbo_v2_5 (新世代、推奨) /
                                        # eleven_multilingual_v2 (旧、accent混入)/
                                        # eleven_flash_v2_5 (最速、品質低)
VAPI_VOICE_STABILITY=0.78               # 0.0-1.0 (= 高めで滑らかな rhythm、perceived speed↓)
VAPI_VOICE_SIMILARITY=0.55              # 0.0-1.0 (= さらに下げて artifact 抑制)
VAPI_VOICE_STYLE=0.15                   # 0.0-1.0 (= 6th pass で抑揚増、0.2 超で外国人化リスク)
VAPI_VOICE_SPEED=0.9                    # 0.5-2.0 (= 0.9 で 10% 遅く、1.0 default、★スピード直制御)
VAPI_VOICE_SPEAKER_BOOST=false          # true/false (= true は雑音源、false 推奨)
VAPI_VOICE_LATENCY=0                    # 0-4 (= 0 最高品質、4 最速。voice-align は 0 推奨)
# 「間」の制御 (★2026-05-26 5th pass):
VAPI_WAIT_SECONDS=1.0                   # bot 発話前の wait sec (= 思考の間、0.5-1.5)
VAPI_STOP_NUM_WORDS=2                   # user 割込で bot 止める word 数 (= 2-3 で控えめ)
VAPI_STOP_VOICE_SEC=0.3                 # 割込判定の voice 持続 sec (= 0.3 で誤検知防止)
VAPI_STOP_BACKOFF_SEC=1.0               # 割込後の沈黙待ち sec (= 1.0 で自然に間置く)
# ★2026-05-27 蒸留 path fix: Vapi end-of-call-report webhook 送信先
# (= web SDK は assistant config に server URL 明示しないと event drop)
VAPI_SERVER_URL=https://brain.example.com/webhook/voice-alignment
# tuning hint:
#   声が単調 → style を 0.15 / 0.2 (= 0.2 超で外国人化リスク)
#   別人風 → similarity 0.65 / 0.75 (= 高すぎで雑音復活リスク)
#   雑音再発 → similarity 0.45 まで下げ、または model = eleven_multilingual_v2 試す
#   スピード遅すぎ → stability 0.5 / waitSeconds 0.5 に下げ
#   割込みされすぎ → STOP_NUM_WORDS 3 / STOP_VOICE_SEC 0.5 に上げ

# ─── HeyGen Streaming Avatar (★2026-05-26 海山指示「本人のモーションアバター」) ───
# Live video 通話 (= 会議 代出席 / スタッフ相談) 用 photorealistic avatar。
# HeyGen 1 週間 trial 中。アクセス path: brain.example.com/video-align?token=<VOICE_ALIGN_TOKEN>
# HeyGen dashboard → Account → API Token で 取得
HEYGEN_API_KEY=
# 海山 Custom Avatar の voice ID (= Day 3 = avatar 生成完了後に投入)。
# 未設定なら HeyGen demo avatar (Anna_public_3_20240108) で pipeline verify。
HEYGEN_AVATAR_ID=
# 任意: HeyGen 側で TTS voice ID 指定 (= 未設定なら HeyGen default voice)。
# 将来 ElevenLabs Voice Clone を HeyGen に連携できれば voice-align と統一可能 (= 検証未済)。
HEYGEN_VOICE_ID=

# ─── Hybrid retrieval (BM25 ⊕ dense RRF 融合) ★2026-06-08 §1.15 cross-check 済 ───
# golden eval で hybrid 優位 (nDCG 0.648→0.709) だが、cross-check で「eval が doc-id 順位を
# 測り本番は content を予算に詰める」「golden n=28 が固有名詞偏重で売上/雑談 0 件」と判明。
# → default OFF + selective (dense が弱い=high_conf 0 の時のみ BM25 融合) で実装。
# eval を content 基準に修正 + golden 拡張で再評価してから常時化を判断する。
HYBRID_RETRIEVAL_ENABLED=0              # 1 で有効化 (= selective hybrid 発火)
HYBRID_BM25_TTL_SEC=900                 # BM25 index 再構築 TTL 秒 (= 15分、wiki 変更追従)
